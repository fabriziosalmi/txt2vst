---
import { Drum, Music, Radio, Disc3, Waves, HandMetal, Guitar, Piano, Wind, Sparkles,
         MessageSquare, FileJson, Cog, AudioLines, Keyboard, BellRing, CloudFog,
         Timer, Repeat, Mic2, Gauge, Flame, Palette, Clock,
         Shield, ShieldCheck, Zap, Activity, Cpu,
         Github, ArrowRight, ChevronDown } from 'lucide-astro';

// Self-hosted fonts (AGSSH AG-PRV-03 / AG-NET-01): Inter + JetBrains Mono are
// bundled from @fontsource instead of Google Fonts — the family names match the
// CSS below, so no style changes are needed.
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/800.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/600.css';

const archetypes = [
  { name: "Kick", engine: "Dual envelope + pitch sweep + sub + drive", cpu: "16ns", pct: "0.07%", icon: "drum" },
  { name: "Snare", engine: "Body tone + bandpass noise + snap transient", cpu: "9ns", pct: "0.04%", icon: "disc" },
  { name: "Hats", engine: "6-oscillator ring modulation + noise blend", cpu: "3ns", pct: "0.01%", icon: "radio" },
  { name: "Tom", engine: "Pitched sine + exponential pitch sweep", cpu: "4ns", pct: "0.02%", icon: "music" },
  { name: "Perc/FM", engine: "FM carrier/modulator + index envelope", cpu: "8ns", pct: "0.03%", icon: "sparkles" },
  { name: "Clap", engine: "4 micro-bursts + diffuse tail + bandpass", cpu: "4ns", pct: "0.02%", icon: "hand" },
  { name: "Bass Acid", engine: "PolyBLEP + 4-pole diode ladder filter", cpu: "67ns", pct: "0.30%", icon: "guitar" },
  { name: "Lead", engine: "PolyBLEP pulse/PWM + SVF + portamento", cpu: "8ns", pct: "0.03%", icon: "piano" },
  { name: "Pad", engine: "Detuned saws + sub + LP filter + ADSR", cpu: "8ns", pct: "0.03%", icon: "wind" },
  { name: "Pluck", engine: "Karplus-Strong physical model + damping", cpu: "5ns", pct: "0.02%", icon: "waves" },
  { name: "Organ", engine: "9-drawbar harmonics + rotary speaker sim", cpu: "24ns", pct: "0.10%", icon: "keyboard" },
  { name: "FM Synth", engine: "2-op FM with self-feedback + index env", cpu: "8ns", pct: "0.03%", icon: "bellring" },
  { name: "Noise", engine: "White/pink + SVF filter + Paul Kellet", cpu: "6ns", pct: "0.03%", icon: "cloudfog" },
  { name: "String", engine: "4 detuned saws + pitch drift + SVF LP", cpu: "14ns", pct: "0.06%", icon: "waves" },
  { name: "Brass", engine: "Pulse + PWM + attack swell + DC blocker", cpu: "8ns", pct: "0.04%", icon: "radio" },
  { name: "Sub Bass", engine: "Sine + harmonics + soft saturation", cpu: "4ns", pct: "0.02%", icon: "disc" },
];

const fxTypes = [
  { name: "Delay", engine: "Stereo ping-pong, tempo sync, LP feedback", icon: "timer" },
  { name: "Reverb", engine: "Schroeder 4-comb + 2-allpass, damping", icon: "repeat" },
  { name: "Chorus", engine: "Dual LFO modulated delay, stereo", icon: "mic2" },
  { name: "Compressor", engine: "Feed-forward, attack/release, makeup", icon: "gauge" },
  { name: "Distortion", engine: "Asymmetric tube-style soft clip", icon: "flame" },
  { name: "Phaser", engine: "4-stage stereo allpass + LFO sweep", icon: "repeat" },
  { name: "EQ", engine: "3-band: low/mid-para/high shelf", icon: "gauge" },
  { name: "Gate", engine: "Envelope follower + threshold + hold", icon: "timer" },
];

const themes = [
  { name: "Midnight", colors: ["#0d0d1a","#1a1a2e","#00c896"] },
  { name: "Void", colors: ["#050508","#0a0a10","#8888ff"] },
  { name: "Obsidian", colors: ["#080808","#141414","#a0a0a0"] },
  { name: "Acid", colors: ["#0a0f0a","#142014","#39ff14"] },
  { name: "Neon", colors: ["#0a0010","#180028","#ff00ff"] },
  { name: "Glow", colors: ["#060612","#0e0e22","#00ffcc"] },
  { name: "Strobe", colors: ["#0a0a0a","#151515","#ffff00"] },
  { name: "Matrix", colors: ["#000a00","#001400","#00ff41"] },
  { name: "Ember", colors: ["#140a08","#261410","#ff6b35"] },
  { name: "Solar", colors: ["#100c04","#201808","#ffc107"] },
  { name: "Copper", colors: ["#0e0a08","#1c1410","#cc7744"] },
  { name: "Candy", colors: ["#120810","#221018","#ff66aa"] },
  { name: "Frost", colors: ["#080c14","#101828","#5ebaff"] },
  { name: "Chrome", colors: ["#0c0c10","#18181e","#c0c0d0"] },
  { name: "Arctic", colors: ["#040810","#0a1420","#88ddff"] },
  { name: "Vapor", colors: ["#0a0818","#1a1030","#ff71ce"] },
  { name: "Industrial", colors: ["#0c0c0c","#1a1a1a","#ff8800"] },
  { name: "Terminal", colors: ["#000000","#0a0a0a","#33ff33"] },
  { name: "Hologram", colors: ["#060818","#0e1228","#44eeff"] },
  { name: "White", colors: ["#f0f0f4","#ffffff","#2266cc"] },
  { name: "Cream", colors: ["#f5f0e8","#fffaf4","#996633"] },
  { name: "Blood", colors: ["#100404","#200a0a","#ff2222"] },
  { name: "Lavender", colors: ["#0c0810","#181420","#aa88ff"] },
];

const guardrails = [
  { id: "1", rule: "No NaN", threshold: "0 occurrences", purpose: "Numerical stability" },
  { id: "2", rule: "No Inf", threshold: "0 occurrences", purpose: "Filter stability" },
  { id: "3", rule: "Peak amplitude", threshold: "< 1.5", purpose: "Headroom before clipping" },
  { id: "4", rule: "DC offset", threshold: "< 0.01", purpose: "No speaker damage" },
  { id: "5", rule: "CPU usage", threshold: "< 5% per voice", purpose: "Real-time safety" },
  { id: "6", rule: "Deactivation", threshold: "Must stop", purpose: "No infinite tails" },
];

const iconMap: Record<string, any> = {
  drum: Drum, disc: Disc3, radio: Radio, music: Music,
  sparkles: Sparkles, hand: HandMetal, guitar: Guitar,
  piano: Piano, wind: Wind, waves: Waves,
  keyboard: Keyboard, bellring: BellRing, cloudfog: CloudFog,
  timer: Timer, repeat: Repeat, mic2: Mic2, gauge: Gauge, flame: Flame,
};
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>txt2vst — Text to VST in One Command</title>
  <meta name="description" content="Generate VST3/AU instruments from natural language. 16 voice + 8 FX archetypes, 46/46 Occam guardrails, 23 UI themes." />
  <meta property="og:title" content="txt2vst — Text to VST" />
  <meta property="og:description" content="Generate production VST instruments from text. 10 archetypes, Occam guardrails." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://txt2vst.com" />
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2300d4a0' stroke-width='2'><path d='M9 18V5l12-2v13'/><circle cx='6' cy='18' r='3'/><circle cx='18' cy='16' r='3'/></svg>" />
  <script is:inline src="/vendor/jszip.min.js"></script>
</head>
<body>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-glow"></div>
    <div class="hero-grid"></div>
    <div class="hero-content">
      <div class="badge"><ShieldCheck size={14} /> Open Source &middot; 16 Voices + 8 FX &middot; 46/46 Tests</div>
      <h1>txt<span class="accent">2</span>vst</h1>
      <p class="tagline">Text &rarr; VST in One Command</p>
      <p class="subtitle">Generate VST3/AU instruments from natural language.<br/>16 voice engines. 8 FX processors. 23 UI themes. Zero friction.</p>

      <div class="terminal">
        <div class="terminal-bar">
          <span class="dot red"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
          <span class="terminal-title">txt2vst</span>
        </div>
        <pre><code><span class="cm"># From text to VST3 in seconds</span>
<span class="pr">$</span> python3 prompt2spec.py <span class="str">"drum machine acid 4 channels"</span>
<span class="pr">$</span> python3 forge.py spec.json output/AcidBox
<span class="pr">$</span> cmake -B build && cmake --build build
<span class="out">  [100%] Built target AcidBox_VST3</span>
<span class="out">  Installed: ~/Library/Audio/Plug-Ins/VST3/AcidBox.vst3</span></code></pre>
      </div>

      <div class="hero-stats">
        <div class="stat">
          <span class="stat-icon"><AudioLines size={20} /></span>
          <span class="stat-num">16+8</span>
          <span class="stat-lbl">DSP Archetypes</span>
        </div>
        <div class="stat">
          <span class="stat-icon"><Palette size={20} /></span>
          <span class="stat-num">10M+</span>
          <span class="stat-lbl">Unique Sounds</span>
        </div>
        <div class="stat">
          <span class="stat-icon"><Clock size={20} /></span>
          <span class="stat-num">2.7B+</span>
          <span class="stat-lbl">Visual Combos</span>
        </div>
        <div class="stat">
          <span class="stat-icon"><Zap size={20} /></span>
          <span class="stat-num">~1500</span>
          <span class="stat-lbl">LOC Generated</span>
        </div>
      </div>

      <div class="hero-cta">
        <a href="https://github.com/fabriziosalmi/txt2vst" class="btn-primary">
          <Github size={18} /> View on GitHub
        </a>
        <a href="https://huggingface.co/spaces/fabriziosalmi/txt2vst" class="btn-primary" style="background:linear-gradient(135deg,#ff9d00,#ffcd00);color:#000;">
          🤗 Try on HuggingFace
        </a>
        <a href="#archetypes" class="btn-ghost">Explore Archetypes <ChevronDown size={16} /></a>
      </div>
    </div>
  </section>

  <!-- PIPELINE -->
  <section class="section" id="pipeline">
    <div class="container">
      <h2 class="section-title">How It Works</h2>
      <p class="section-sub">Four stages. Fully deterministic. No LLM in the audio path.</p>
      <div class="pipeline">
        <div class="pipe-card">
          <div class="pipe-num">1</div>
          <div class="pipe-icon"><MessageSquare size={28} /></div>
          <div class="pipe-label">Natural Language</div>
          <div class="pipe-sub">"acid drum machine 4ch"</div>
        </div>
        <div class="pipe-arrow"><ArrowRight size={22} /></div>
        <div class="pipe-card">
          <div class="pipe-num">2</div>
          <div class="pipe-icon"><FileJson size={28} /></div>
          <div class="pipe-label">spec.json</div>
          <div class="pipe-sub">Channels, voices, features</div>
        </div>
        <div class="pipe-arrow"><ArrowRight size={22} /></div>
        <div class="pipe-card">
          <div class="pipe-num">3</div>
          <div class="pipe-icon"><Cog size={28} /></div>
          <div class="pipe-label">Forge + Router</div>
          <div class="pipe-sub">22 C++ files generated</div>
        </div>
        <div class="pipe-arrow"><ArrowRight size={22} /></div>
        <div class="pipe-card">
          <div class="pipe-num">4</div>
          <div class="pipe-icon"><AudioLines size={28} /></div>
          <div class="pipe-label">VST3 / AU</div>
          <div class="pipe-sub">Installed & ready</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ARCHETYPES -->
  <section class="section section-dark" id="archetypes">
    <div class="container">
      <h2 class="section-title">16 Voice Archetypes</h2>
      <p class="section-sub">Each voice gets a purpose-built synthesis engine &mdash; not a generic fallback.</p>
      <div class="arch-grid">
        {archetypes.map(a => {
          const Icon = iconMap[a.icon];
          return (
            <div class="arch-card">
              <div class="arch-icon"><Icon size={24} /></div>
              <div class="arch-info">
                <div class="arch-name">{a.name}</div>
                <div class="arch-engine">{a.engine}</div>
                <div class="arch-cpu">{a.cpu}/sample &middot; {a.pct} CPU</div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- GUARDRAILS -->
  <section class="section" id="guardrails">
    <div class="container">
      <h2 class="section-title">Occam Guardrails</h2>
      <p class="section-sub">Every archetype passes a 6-point quality gate. Default and extreme parameters. No exceptions.</p>
      <div class="guard-grid">
        {guardrails.map(g => (
          <div class="guard-card">
            <div class="guard-id"><Shield size={14} /></div>
            <div class="guard-body">
              <div class="guard-rule">{g.rule}</div>
              <div class="guard-thresh">{g.threshold}</div>
              <div class="guard-purpose">{g.purpose}</div>
            </div>
          </div>
        ))}
      </div>
      <div class="terminal" style="margin-top: 2.5rem; max-width: 620px;">
        <div class="terminal-bar">
          <span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span>
          <span class="terminal-title">test results</span>
        </div>
        <pre><code><span class="out">  40/40 All Occam guardrails satisfied!</span>
<span class="cm"># cd dsplib && g++ -std=c++17 -O2 -I voices \</span>
<span class="cm">#   -o test tests/test_voices.cpp && ./test</span></code></pre>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section" id="fx">
    <div class="container">
      <h2 class="section-title">8 FX Processors</h2>
      <p class="section-sub">Master bus effects, routed per-channel or globally. All Occam-safe.</p>
      <div class="fx-grid">
        {fxTypes.map(f => {
          const Icon = iconMap[f.icon];
          return (
            <div class="fx-card">
              <div class="fx-icon"><Icon size={20} /></div>
              <div class="fx-name">{f.name}</div>
              <div class="fx-engine">{f.engine}</div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section section-dark" id="themes">
    <div class="container">
      <h2 class="section-title">24 UI Themes</h2>
      <p class="section-sub">Set <code style="color:var(--accent);">"theme": "acid"</code> in your spec and the generated plugin gets a matching color palette.</p>
      <div class="theme-grid">
        {themes.map(t => (
          <div class="theme-card">
            <div class="theme-swatches">
              {t.colors.map(c => <div class="theme-swatch" style={`background:${c}`}></div>)}
            </div>
            <div class="theme-name">{t.name}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- GENERATOR -->
  <section class="section" id="generator">
    <div class="container">
      <h2 class="section-title">Forge Your Plugin</h2>
      <p class="section-sub">Configure your instrument visually. Download the spec, run two commands, done.</p>

      <div class="gen-panel">
        <!-- Plugin Name -->
        <div class="gen-row">
          <label class="gen-label">Plugin Name</label>
          <input type="text" id="gen-name" class="gen-input" value="MyPlugin" spellcheck="false" />
          <button class="btn-random" id="btn-random" title="Randomize">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/></svg>
            Random
          </button>
        </div>

        <!-- Voices -->
        <div class="gen-group">
          <label class="gen-label">Voices <span class="gen-count" id="voice-count">0</span></label>
          <div class="gen-chips" id="voice-chips"></div>
        </div>

        <!-- FX -->
        <div class="gen-group">
          <label class="gen-label">FX Chain <span class="gen-count" id="fx-count">0</span></label>
          <div class="gen-chips" id="fx-chips"></div>
        </div>

        <!-- Knob Controls -->
        <div class="gen-knob-well">
          <div class="gen-knobs-row">
            <div class="knob-group">
              <label class="gen-label">Theme</label>
              <div class="knob-wrap" id="knob-theme">
                <svg class="knob-svg" viewBox="0 0 80 80">
                  <circle cx="40" cy="40" r="34" class="knob-track"/>
                  <circle cx="40" cy="40" r="34" class="knob-arc" id="knob-theme-arc"/>
                  <circle cx="40" cy="40" r="26" class="knob-body"/>
                  <line x1="40" y1="40" x2="40" y2="18" class="knob-pointer" id="knob-theme-ptr"/>
                </svg>
                <div class="knob-val" id="knob-theme-val">midnight</div>
              </div>
            </div>
            <div class="knob-group">
              <label class="gen-label">Mastering</label>
              <div class="knob-wrap" id="knob-master">
                <svg class="knob-svg" viewBox="0 0 80 80">
                  <circle cx="40" cy="40" r="34" class="knob-track"/>
                  <circle cx="40" cy="40" r="34" class="knob-arc" id="knob-master-arc"/>
                  <circle cx="40" cy="40" r="26" class="knob-body"/>
                  <line x1="40" y1="40" x2="40" y2="18" class="knob-pointer" id="knob-master-ptr"/>
                </svg>
                <div class="knob-val" id="knob-master-val">bypass</div>
              </div>
            </div>
            <div class="knob-group">
              <label class="gen-label">Channels</label>
              <div class="knob-wrap" id="knob-channels">
                <svg class="knob-svg" viewBox="0 0 80 80">
                  <circle cx="40" cy="40" r="34" class="knob-track"/>
                  <circle cx="40" cy="40" r="34" class="knob-arc" id="knob-ch-arc"/>
                  <circle cx="40" cy="40" r="26" class="knob-body"/>
                  <line x1="40" y1="40" x2="40" y2="18" class="knob-pointer" id="knob-ch-ptr"/>
                </svg>
                <div class="knob-val" id="knob-ch-val">4</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Output -->
        <div class="gen-output">
          <div class="terminal" style="margin:0">
            <div class="terminal-bar">
              <span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span>
              <span class="terminal-title">spec.json preview</span>
            </div>
            <pre><code id="spec-preview" class="out">{ }</code></pre>
          </div>
          <div class="gen-actions">
            <button class="btn-primary btn-lg" id="btn-download-zip">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
              Download Project ZIP
            </button>
            <button class="btn-secondary" id="btn-download">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
              spec.json only
            </button>
            <button class="btn-secondary" id="btn-copy-cmd">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
              Copy Commands
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-cta">
    <div class="container cta-inner">
      <h2 class="cta-title">Ready to forge?</h2>
      <p class="section-sub" style="margin-bottom:2rem;">Clone. Describe. Build. Ship.</p>
      <div style="display:flex;gap:0.75rem;justify-content:center;flex-wrap:wrap;">
        <a href="https://github.com/fabriziosalmi/txt2vst" class="btn-primary btn-lg">
          <Github size={20} /> Get Started on GitHub <ArrowRight size={18} />
        </a>
        <a href="https://huggingface.co/spaces/fabriziosalmi/txt2vst" class="btn-primary btn-lg" style="background:linear-gradient(135deg,#ff9d00,#ffcd00);color:#000;">
          🤗 Try Online — No Install
        </a>
      </div>
    </div>
  </section>

  <footer>
    <div class="container">
      <p>Made by <a href="https://github.com/fabriziosalmi">fabriziosalmi</a></p>
      <p class="footer-sub" style="margin-top:0.6rem;">
        <a href="https://github.com/fabriziosalmi/txt2vst">GitHub</a> &middot;
        <a href="https://huggingface.co/spaces/fabriziosalmi/txt2vst">HuggingFace Space</a> &middot;
        <a href="https://huggingface.co/datasets/fabriziosalmi/txt2vst">Dataset</a>
      </p>
      <p class="footer-sub">txt2vst &mdash; From text to sound, no friction, no limits.</p>
    </div>
  </footer>

</body>
</html>

<style is:global>
  :root {
    --bg: #060610;
    --bg2: #0a0a18;
    --surface: #111122;
    --surface2: #161630;
    --accent: #00d4a0;
    --accent2: #5ebaff;
    --accent3: #f0c040;
    --text: #e8e8f0;
    --muted: #6a6a88;
    --border: rgba(255,255,255,0.05);
    --glow: rgba(0, 212, 160, 0.10);
    --radius: 14px;
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
  }
  *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'Inter', -apple-system, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.65;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  .container { max-width: 1080px; margin: 0 auto; padding: 0 1.5rem; }

  /* ─── SCROLL REVEAL ─── */
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .spin { animation: spin 0.8s linear infinite; }

  .section { animation: fadeInUp 0.7s var(--ease) both; }
  .hero-content { animation: fadeInUp 0.9s var(--ease) 0.15s both; }
  .hero-stats { animation: fadeInUp 0.7s var(--ease) 0.4s both; }
  .hero-cta { animation: fadeInUp 0.6s var(--ease) 0.55s both; }

  /* ─── SECTION DIVIDERS ─── */
  .section + .section::before {
    content: '';
    display: block;
    height: 1px;
