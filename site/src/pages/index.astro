<script>
(function() {
  const VOICES = [
    {id:"kick",t:"drum"},{id:"snare",t:"drum"},{id:"hats",t:"drum"},
    {id:"tom",t:"drum"},{id:"perc",t:"drum"},{id:"clap",t:"drum"},
    {id:"bass_acid",t:"pitched",label:"Bass Acid"},{id:"lead",t:"pitched"},
    {id:"pad",t:"pitched"},{id:"pluck",t:"pitched"},{id:"organ",t:"pitched"},
    {id:"fm_synth",t:"pitched",label:"FM Synth"},{id:"noise",t:"pitched"},
    {id:"string",t:"pitched"},{id:"brass",t:"pitched"},
    {id:"sub_bass",t:"pitched",label:"Sub Bass"}
  ];
  const FX = ["delay","reverb","chorus","compressor","distortion","phaser","eq","gate"];
  const THEMES = ["midnight","void","obsidian","acid","neon","glow","strobe","matrix",
                   "ember","solar","copper","candy","frost","chrome","arctic",
                   "vapor","industrial","terminal","hologram","white","cream","blood","lavender"];
  const MASTERS = ["bypass","transparent","punch","wet","radio","distorted","wide"];
  const NAMES = ["AcidBox","NeuroSynth","VoidDrum","SubStation","OrbitPad","CrushLab",
                  "NeonPulse","FrostBite","GlitchKit","SolarWave","BrassHammer","HazeEngine",
                  "DeepRoot","QuantumBeat","CrystalFM","DustKick","TubeForge","MoonBass"];

  let selectedVoices = new Set();
  let selectedFx = new Set();
  let themeIdx = 0, masterIdx = 0, chCount = 4;

  // ── Chip builders ──
  function buildChips(containerId, items, selectedSet, countId) {
    const c = document.getElementById(containerId);
    c.innerHTML = '';
    items.forEach(item => {
      const chip = document.createElement('span');
      chip.className = 'gen-chip' + (selectedSet.has(item.id || item) ? ' active' : '');
      chip.textContent = (item.label || item.id || item).replace(/_/g,' ');
      chip.addEventListener('click', () => {
        const key = item.id || item;
        if (selectedSet.has(key)) selectedSet.delete(key);
        else selectedSet.add(key);
        chip.classList.toggle('active');
        document.getElementById(countId).textContent = selectedSet.size;
        updatePreview();
      });
      c.appendChild(chip);
    });
  }

  // ── Knob logic ──
  function updateKnob(arcId, ptrId, valId, index, total, values) {
    const frac = total > 1 ? index / (total - 1) : 0;
    const usable = 175 - 44; // arc length minus gap
    const offset = 175 - frac * usable;
    document.getElementById(arcId).style.strokeDashoffset = offset;
    const angle = -135 + frac * 270;
    document.getElementById(ptrId).style.transform = `rotate(${angle}deg)`;
    document.getElementById(valId).textContent = values[index];
  }

  function attachKnob(wrapId, arcId, ptrId, valId, values, getIdx, setIdx) {
    const el = document.getElementById(wrapId);
    let dragging = false, startY = 0, startIdx = 0;
    el.addEventListener('mousedown', e => {
      dragging = true; startY = e.clientY; startIdx = getIdx(); e.preventDefault();
    });
    el.addEventListener('wheel', e => {
      e.preventDefault();
      let idx = getIdx() + (e.deltaY < 0 ? 1 : -1);
      idx = Math.max(0, Math.min(idx, values.length - 1));
      setIdx(idx);
      updateKnob(arcId, ptrId, valId, idx, values.length, values);
      updatePreview();
    });
    window.addEventListener('mousemove', e => {
      if (!dragging) return;
      const dy = startY - e.clientY;
      let idx = startIdx + Math.round(dy / 20);
      idx = Math.max(0, Math.min(idx, values.length - 1));
      setIdx(idx);
      updateKnob(arcId, ptrId, valId, idx, values.length, values);
      updatePreview();
    });
    window.addEventListener('mouseup', () => { dragging = false; });
    updateKnob(arcId, ptrId, valId, getIdx(), values.length, values);
  }

  // ── Spec builder ──
  function buildSpec() {
    const name = document.getElementById('gen-name').value.replace(/[^a-zA-Z0-9]/g,'') || 'MyPlugin';
    const voices = [...selectedVoices];
    const theme = THEMES[themeIdx];
    const master = MASTERS[masterIdx];

    const channels = [];
    const voiceSpecs = [];
    let midiNote = 36, midiCh = 2;
    const voiceInfo = Object.fromEntries(VOICES.map(v => [v.id, v]));

    voices.forEach(vid => {
      const v = voiceInfo[vid];
      if (!v) return;
      const chName = (v.label || v.id).replace(/[_ ]/g,'');
      if (v.t === 'drum') {
        channels.push({name: chName, type: 'drum', midi: midiNote++});
      } else {
        channels.push({name: chName, type: 'pitched', midi_ch: midiCh++});
      }
      voiceSpecs.push({name: chName, params: getDefaultParams(vid)});
    });

    const prefix = name.substring(0,3).toUpperCase();
    const code = name.substring(0,4);
    const features = {
      sequencer: channels.some(c => c.type === 'drum'),
      swing: false,
      sidechain: false,
      master_fx: [...selectedFx]
    };
    if (master !== 'bypass') features.mastering = master;

    const spec = {
      plugin: { name, version: '0.1.0', company: 'txt2vst', prefix, mfr_code: 'Tx2v', code, ui: [1031,625] },
      channels, voices: voiceSpecs, features
    };
    if (theme !== 'midnight') spec.plugin.theme = theme;
    return spec;
  }

  function getDefaultParams(archId) {
    const map = {
      kick:['tune','decay','punch','sub'], snare:['tune','decay','snap','noise'],
      hats:['tune','decay','tone','body'], tom:['tune','decay','pitchenv','attack'],
      perc:['tune','decay','detune','drive'], clap:['decay','spread','attack'],
      bass_acid:['cutoff','reso','envmod','decay','accent'], lead:['cutoff','reso','pw','decay','detune'],
      pad:['cutoff','reso','attack','release','detune'], pluck:['decay','bright','body'],
      organ:['decay','rotary'], fm_synth:['ratio','index','decay','feedback'],
      noise:['cutoff','reso','decay','color'],
      string:['cutoff','reso','attack','release','detune'],
      brass:['cutoff','reso','attack','decay','bright'],
      sub_bass:['decay','sub','harmonics','drive']
    };
    return map[archId] || ['decay'];
  }

  function updatePreview() {
    const spec = buildSpec();
    document.getElementById('spec-preview').textContent = JSON.stringify(spec, null, 2);
  }

  // ── Random ──
  function randomize() {
    selectedVoices.clear();
    selectedFx.clear();
    const nVoices = 2 + Math.floor(Math.random() * 5);
    const shuffled = [...VOICES].sort(() => Math.random() - 0.5);
    for (let i = 0; i < Math.min(nVoices, shuffled.length); i++) selectedVoices.add(shuffled[i].id);
    const nFx = Math.floor(Math.random() * 4);
    const fxShuf = [...FX].sort(() => Math.random() - 0.5);
    for (let i = 0; i < nFx; i++) selectedFx.add(fxShuf[i]);
    themeIdx = Math.floor(Math.random() * THEMES.length);
    masterIdx = Math.floor(Math.random() * MASTERS.length);
    chCount = selectedVoices.size;
    document.getElementById('gen-name').value = NAMES[Math.floor(Math.random() * NAMES.length)];
    buildChips('voice-chips', VOICES, selectedVoices, 'voice-count');
    buildChips('fx-chips', FX, selectedFx, 'fx-count');
    document.getElementById('voice-count').textContent = selectedVoices.size;
    document.getElementById('fx-count').textContent = selectedFx.size;
    updateKnob('knob-theme-arc','knob-theme-ptr','knob-theme-val', themeIdx, THEMES.length, THEMES);
    updateKnob('knob-master-arc','knob-master-ptr','knob-master-val', masterIdx, MASTERS.length, MASTERS);
    updatePreview();
  }

  // ── Download ZIP ──
  async function downloadZip() {
    const spec = buildSpec();
    const name = spec.plugin.name;
    const fn = name.toLowerCase();
    const btn = document.getElementById('btn-download-zip');
    const origHTML = btn.innerHTML;
    btn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="spin"><path d="M21 12a9 9 0 11-6.219-8.56"/></svg> Generating...';
    btn.disabled = true;

    try {
      const zip = new JSZip();
      const root = zip.folder(fn);

      // spec.json
      root.file('spec.json', JSON.stringify(spec, null, 2));

      // build.sh — one-command build + install
      root.file('build.sh', [
        '#!/usr/bin/env bash',
        'set -euo pipefail',
        '',
        'echo "=== txt2vst Project Builder ==="',
        'echo ""',
        '',
        '# Check dependencies',
        'command -v python3 >/dev/null 2>&1 || { echo "python3 required"; exit 1; }',
        'command -v cmake >/dev/null 2>&1 || { echo "cmake required (brew install cmake)"; exit 1; }',
        'command -v git >/dev/null 2>&1 || { echo "git required"; exit 1; }',
        '',
        'SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"',
        'cd "$SCRIPT_DIR"',
        '',
        '# Clone txt2vst engine (if not present)',
        'if [ ! -d "txt2vst" ]; then',
        '  echo "[1/4] Cloning txt2vst engine..."',
        '  git clone https://github.com/fabriziosalmi/txt2vst.git txt2vst',
        'else',
        '  echo "[1/4] txt2vst engine found, updating..."',
        '  cd txt2vst && git pull && cd ..',
        'fi',
        '',
        '# Generate project from spec',
        'echo "[2/4] Generating ' + name + ' source..."',
        'python3 txt2vst/forge.py spec.json ./project',
        '',
        '# Build',
        'echo "[3/4] Building VST3..."',
        'cd project',
        'cmake -B build -DCMAKE_BUILD_TYPE=Release',
        'cmake --build build --config Release',
        '',
        '# Install',
        'echo "[4/4] Installing..."',
        'VST3_DIR="$HOME/Library/Audio/Plug-Ins/VST3"',
        'if [ "$(uname)" = "Linux" ]; then',
        '  VST3_DIR="$HOME/.vst3"',
        'fi',
        'mkdir -p "$VST3_DIR"',
        'find build -name "*.vst3" -exec cp -r {} "$VST3_DIR/" \\;',
        '',
        'echo ""',
        'echo "=== Done! ==="',
        'echo "VST3 installed to: $VST3_DIR"',
        'echo "Restart your DAW to load ' + name + '"',
      ].join('\n'));

      // README.md — three personas
      root.file('README.md', [
        '# ' + name,
        '',
        'Generated by [txt2vst](https://txt2vst.com) — 10M+ unique sound combinations.',
        '',
        '## Quick Start',
        '',
        '### For Producers (Ableton / FL / Logic)',
        '```bash',
        'chmod +x build.sh && ./build.sh',
        '```',
        'Restart your DAW. ' + name + ' appears under VST3 instruments.',
        '',
        '### For Sound Engineers',
        '```bash',
        '# Edit spec.json to fine-tune voice params, FX chain, mastering preset',
        '# Then build:',
        './build.sh',
        '```',
        'The spec controls every parameter: voice archetypes, FX routing,',
        'mastering chain (transparent/punch/wet/radio/distorted/wide), and UI theme.',
        '',
        '### For Developers',
        '```bash',
        '# Generate source only (no build):',
        'python3 txt2vst/forge.py spec.json ./project',
        '',
        '# Inspect generated C++:',
        'ls project/src/',
        '',
        '# Custom build:',
        'cd project && cmake -B build -DCMAKE_BUILD_TYPE=Debug && cmake --build build',
        '```',
        '',
        '## Requirements',
        '- macOS 12+ / Linux / Windows 10+',
        '- Python 3.10+',
        '- CMake 3.22+',
        '- C++17 compiler (Xcode / GCC 11+ / MSVC 2022)',
        '- JUCE 7 (auto-fetched by CMake)',
        '',
        '## Spec',
        '```json',
        JSON.stringify(spec, null, 2),
        '```',
        '',
        '---',
        '*Generated at ' + new Date().toISOString().split('T')[0] + ' by txt2vst.com*',
      ].join('\n'));

      const blob = await zip.generateAsync({type: 'blob'});
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = fn + '-vst-project.zip';
      a.click();
      URL.revokeObjectURL(a.href);
    } catch(e) {
      console.error(e);
    }

    btn.innerHTML = origHTML;
    btn.disabled = false;
  }

  // ── Download spec only ──
  function downloadSpec() {
    const spec = buildSpec();
    const blob = new Blob([JSON.stringify(spec, null, 2)], {type: 'application/json'});
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = spec.plugin.name.toLowerCase() + '.spec.json';
    a.click();
    URL.revokeObjectURL(a.href);
  }

  function copyCommands() {
    const name = document.getElementById('gen-name').value || 'MyPlugin';
    const fn = name.toLowerCase() + '.spec.json';
    const cmds = `python3 forge.py ${fn} output/${name}\ncd output/${name} && cmake -B build && cmake --build build`;
    navigator.clipboard.writeText(cmds).then(() => {
      const btn = document.getElementById('btn-copy-cmd');
      const orig = btn.innerHTML;
      btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> Copied!';
      setTimeout(() => { btn.innerHTML = orig; }, 1500);
    });
  }

  // ── Init ──
  document.addEventListener('DOMContentLoaded', () => {
    buildChips('voice-chips', VOICES, selectedVoices, 'voice-count');
    buildChips('fx-chips', FX, selectedFx, 'fx-count');
    attachKnob('knob-theme','knob-theme-arc','knob-theme-ptr','knob-theme-val',
               THEMES, () => themeIdx, i => { themeIdx = i; });
    attachKnob('knob-master','knob-master-arc','knob-master-ptr','knob-master-val',
               MASTERS, () => masterIdx, i => { masterIdx = i; });
    const CH_VALS = ['1','2','3','4','5','6','7','8'];
    attachKnob('knob-channels','knob-ch-arc','knob-ch-ptr','knob-ch-val',
               CH_VALS, () => chCount - 1, i => { chCount = i + 1; });
    document.getElementById('btn-random').addEventListener('click', randomize);
    document.getElementById('btn-download-zip').addEventListener('click', downloadZip);
    document.getElementById('btn-download').addEventListener('click', downloadSpec);
    document.getElementById('btn-copy-cmd').addEventListener('click', copyCommands);
    document.getElementById('gen-name').addEventListener('input', updatePreview);
    updatePreview();
  });
})();
</script>
