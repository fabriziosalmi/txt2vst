private:
    std::array<int, Sequencer::NUM_CHANNELS> lastSteps;
    int64_t prevBar = -1;
    double currentSampleRate = 44100.0;

    // Mono crossover: LP filter states per bus
    struct CrossoverState { float lpL = 0.0f, lpR = 0.0f; };
    std::array<CrossoverState, {{PLUGIN_PREFIX}}Bus::COUNT> crossover {};
    float crossoverAlpha = 0.04f;

{{#HAS_DELAY}}
    // Delay FX
    static constexpr int MAX_DELAY_SAMPLES = 96000;
    struct DelayState {
        std::array<float, MAX_DELAY_SAMPLES> bufL {}, bufR {};
        int writePos = 0;
        float smoothedDelay = 0.0f;
    };
    std::array<DelayState, 1> delay {};
{{/HAS_DELAY}}

    JUCE_DECLARE_NON_COPYABLE_WITH_LEAK_DETECTOR({{PLUGIN_NAME}}Processor)
};
